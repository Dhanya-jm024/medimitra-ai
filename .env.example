# ═══════════════════════════════════════
# MEDIMITRA AI — ENVIRONMENT CONFIGURATION (.env.example)
# ═══════════════════════════════════════

# ═══════════════════════════════════════
# FRONTEND CONFIGURATION
# ═══════════════════════════════════════

# Application URL
NEXT_PUBLIC_APP_URL=https://dhanya-medimitra.vercel.app

# Google Gemini AI API Key (Free Tier)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
# Get from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps API Key
# Get from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Twilio (for Emergency SMS)
# Get from: https://www.twilio.com/console
NEXT_PUBLIC_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id_here

# ═══════════════════════════════════════
# BACKEND CONFIGURATION
# ═══════════════════════════════════════

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Google Gemini API (Backend)
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/medimitra

# Supabase Admin Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Twilio Credentials (Backend)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# OpenFDA API (for medicine safety data)
OPENFDA_API_KEY=your_openfda_key_here

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your_jwt_secret_min_32_chars_long_here
CORS_ORIGINS=http://localhost:3000,https://dhanya-medimitra.vercel.app

# ═══════════════════════════════════════
# DEPLOYMENT
# ═══════════════════════════════════════

VERCEL_TOKEN=your_vercel_token_here
RAILWAY_TOKEN=your_railway_token_here
